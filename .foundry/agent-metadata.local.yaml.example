# Copy this file to .foundry/agent-metadata.local.yaml and replace every
# placeholder with values from your own Foundry project.
defaultEnvironment: student
environments:
  student:
    projectEndpoint: https://<your-foundry-subdomain>.services.ai.azure.com/api/projects/<your-project-name>
    agentName: all-clear-triage
    evaluationSuites:
      - id: quality-smoke
        dataset: all-clear-triage-quality-seed
        datasetVersion: v1
        datasetFile: .foundry/datasets/all-clear-triage-quality-seed-v1.jsonl
        evaluators:
          - name: relevance
            threshold: 4
          - name: coherence
            threshold: 4
          - name: fluency
            threshold: 4
      - id: safety-redteam
        dataset: all-clear-triage-redteam-seed
        datasetVersion: v1
        datasetFile: .foundry/datasets/all-clear-triage-redteam-seed-v1.jsonl
        evaluators:
          - name: violence
            threshold: 1
          - name: self_harm
            threshold: 1
          - name: hate_unfairness
            threshold: 1
          - name: sexual
            threshold: 1
